# LinuxDroid Desktop Environment (LDDE) Configuration File
#
# Precedence:
# 1. Built-in defaults
# 2. System configuration: /etc/linuxdroid/desktop.conf
# 3. User configuration:   ~/.config/linuxdroid/desktop.conf
# 4. Command-line overrides

[general]
# Configuration version for schema migration compatibility
config_version = 1

# Desktop environment identification
desktop_name = LDDE

[logging]
# Minimum logging severity level: TRACE, DEBUG, INFO, WARN, ERROR, FATAL
level = INFO

[display]
# Default UI scale factor multiplier
scale_factor = 1.0

[input]
# Enable tap to click on touchpads / touch devices
tap_to_click = true

[shell]
# Shell components enable/disable
status_bar_enabled = true
dock_enabled = true

# Dock position: bottom, left, right, top
dock_position = bottom

# Wallpaper and theme styling (hex format #RRGGBB or #RRGGBBAA)
desktop_bg_top = #111726
desktop_bg_bottom = #0a0e17
status_bg = #161e30dd
dock_bg = #141c2cfa

[window_tracking]
# Enable application tracking endpoint
enabled = true
# Wayland socket name for tracked applications
socket_name = wayland-ldde-apps

