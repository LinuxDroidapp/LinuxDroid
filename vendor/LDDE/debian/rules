#!/usr/bin/make -f
# Debian rules file for linuxdroid-desktop-environment
# Uses debhelper with CMake buildsystem

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_TESTING=OFF

override_dh_auto_install:
	dh_auto_install --destdir=debian/linuxdroid-desktop-environment

override_dh_installchangelogs:
	dh_installchangelogs debian/changelog
