#!/bin/sh
# prerm — pre-removal maintainer script for linuxdroid-desktop-environment
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Do NOT remove /etc/linuxdroid/desktop.conf — it may contain admin customizations.
        # dpkg will prompt to remove conffiles separately based on debian/conffiles.
        ;;
    failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument: '$1'" >&2
        exit 1
        ;;
esac

exit 0
