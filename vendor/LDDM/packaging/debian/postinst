#!/bin/sh
set -e

case "$1" in
    configure)
        # Ensure correct ownership and permissions for configuration
        if [ -d /etc/linuxdroid ]; then
            chmod 0755 /etc/linuxdroid
        fi
        if [ -f /etc/linuxdroid/lddm.conf ]; then
            chmod 0644 /etc/linuxdroid/lddm.conf
        fi

        # Provide fallback directory and symlink /etc/lddm/lddm.conf if not already existing
        if [ ! -e /etc/lddm/lddm.conf ]; then
            mkdir -p /etc/lddm
            ln -sf /etc/linuxdroid/lddm.conf /etc/lddm/lddm.conf || true
        fi

        # Ensure symlink /usr/bin/linuxdroid-display-manager -> lddm exists
        if [ -x /usr/bin/lddm ] && [ ! -e /usr/bin/linuxdroid-display-manager ]; then
            ln -sf lddm /usr/bin/linuxdroid-display-manager || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0

