[Unit]
Description=LinuxDroid Display Manager (LDDM)
Documentation=https://github.com/LinuxDroidapp/LDDM
After=network.target systemd-user-sessions.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/lddm --config @CMAKE_INSTALL_FULL_SYSCONFDIR@/lddm/lddm.conf
Restart=always
RestartSec=2s
KillMode=mixed
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target

